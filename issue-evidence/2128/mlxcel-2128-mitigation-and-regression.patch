+
+//! Manual CUDA regression candidate for long Qwen3 trajectories (#2128).
+//!
+//! Uses the same 42 + 414 token schedule in three fresh-cache iterations;
+//! compares owned native logits bytes, not aliased MLX handles or just argmax.
+//! This eager teacher-forced path does not cover CLI/server async generation.
+//! No particular attention implementation or first divergent step is required.
+//!
+//! Required: MLXCEL_TEST_QWEN_MODEL_DIR (Qwen3 0.6B/1.7B, 4-bit/group64),
+//! MLXCEL_TEST_QWEN_JSONL (a NEW output file). Never downloads or skips a model.
+//! Run with --features cuda --test qwen3_long_determinism, then
+//! --ignored --exact qwen3_long_teacher_forced_logits_are_bitwise_deterministic
+//! --nocapture --test-threads=1. A zero-test invocation is NOT acceptance.
+
+#[test]
+#[ignore = "manual CUDA regression: explicit Qwen3 checkpoint and fresh JSONL output required"]
+fn qwen3_long_teacher_forced_logits_are_bitwise_deterministic() {
+    // Keep the test discoverable without CUDA: explicitly running it must fail,
+    // rather than silently becoming a successful zero-test CUDA gate.
+    #[cfg(not(feature = "cuda"))]
+    panic!("qwen3_long_determinism requires --features cuda");
+    #[cfg(feature = "cuda")]
+    cuda::run();
+}
+
+#[cfg(feature = "cuda")]
+mod cuda {
+    use std::collections::BTreeMap;
+    use std::fs::{self, File, OpenOptions};
+    use std::io::{BufWriter, Write};
+    use std::path::Path;
+
+    use mlxcel::LanguageModel;
+    use mlxcel_core::{MlxArray, UniquePtr, dtype};
+    use serde::Deserialize;
+    use serde_json::{Value, json};
+    use sha2::{Digest, Sha256};
+
+    const ITERATIONS: usize = 3;
+    const DECODE_STEPS: usize = 414;
+    const VOCAB: usize = 151_936;
+    const FIXTURE: &str = include_str!("fixtures/qwen3_long_determinism.json");
+
+    #[derive(Deserialize)]
+    struct Schedule {
+        schema: String,
+        prompt_ids: Vec<i32>,
+        decode_ids: Vec<i32>,
+    }
+
+    struct Snapshot {
+        bytes: Vec<u8>,
+        dtype: i32,
+    }
+
+    fn digest(bytes: &[u8]) -> String {
+        format!("{:x}", Sha256::digest(bytes))
+    }
+
+    fn emit(writer: &mut BufWriter<File>, event: Value) {
+        serde_json::to_writer(&mut *writer, &event).expect("write regression JSONL record");
+        writer.write_all(b"\n").expect("write JSONL newline");
+    }
+
+    fn checkpoint_config(path: &Path) -> Value {
+        let config: Value = serde_json::from_slice(
+            &fs::read(path.join("config.json")).expect("required checkpoint config.json"),
+        )
+        .expect("parse checkpoint config.json");
+        assert_eq!(config["model_type"], "qwen3", "requires dense Qwen3");
+        assert!(
+            matches!(config["hidden_size"].as_u64(), Some(1024) | Some(2048)),
+            "requires Qwen3 0.6B or 1.7B"
+        );
+        assert_eq!(config["vocab_size"].as_u64(), Some(VOCAB as u64));
+        assert_eq!(config["quantization"]["bits"].as_u64(), Some(4));
+        assert_eq!(config["quantization"]["group_size"].as_u64(), Some(64));
+        assert!(
+            path.join("tokenizer.json").is_file(),
+            "missing tokenizer.json"
+        );
+        let index: Value = serde_json::from_slice(
+            &fs::read(path.join("model.safetensors.index.json"))
+                .expect("required checkpoint weight index"),
+        )
+        .expect("parse weight index");
+        let weights = index["weight_map"].as_object().expect("weight_map object");
+        assert!(!weights.is_empty(), "empty checkpoint weight index");
+        for value in weights.values() {
+            let file = value.as_str().expect("weight shard filename");
+            assert!(path.join(file).is_file(), "missing checkpoint shard {file}");
+        }
+        config
+    }
+
+    fn snapshot(logits: &UniquePtr<MlxArray>, iteration: usize, step: usize) -> Snapshot {
+        mlxcel_core::eval(logits);
+        assert_eq!(
+            mlxcel_core::array_shape(logits),
+            [1, 1, VOCAB as i32],
+            "iteration {iteration}, step {step}: expected one complete last-position logit row"
+        );
+        let dtype = mlxcel_core::array_dtype(logits);
+        let bytes = mlxcel_core::array_to_raw_bytes(logits);
+        let size = match dtype {
+            dtype::BFLOAT16 | dtype::FLOAT16 => 2,
+            dtype::FLOAT32 => 4,
+            _ => panic!("iteration {iteration}, step {step}: unsupported logits dtype {dtype}"),
+        };
+        assert_eq!(
+            bytes.len(),
+            VOCAB * size,
+            "iteration {iteration}, step {step}: incomplete native logits snapshot"
+        );
+        // Inspect native exponent bits without adding a GPU cast/evaluation.
+        let finite = match dtype {
+            dtype::BFLOAT16 | dtype::FLOAT16 => {
+                let mask = if dtype == dtype::BFLOAT16 {
+                    0x7f80
+                } else {
+                    0x7c00
+                };
+                bytes
+                    .chunks_exact(2)
+                    .all(|b| u16::from_ne_bytes([b[0], b[1]]) & mask != mask)
+            }
+            dtype::FLOAT32 => bytes
+                .chunks_exact(4)
+                .all(|b| f32::from_ne_bytes([b[0], b[1], b[2], b[3]]).is_finite()),
+            _ => unreachable!(),
+        };
+        assert!(
+            finite,
+            "iteration {iteration}, step {step}: nonfinite native logits; no completed PASS"
+        );
+        Snapshot { bytes, dtype }
+    }
+
+    pub fn run() {
+        let model_dir = std::env::var("MLXCEL_TEST_QWEN_MODEL_DIR")
+            .expect("MLXCEL_TEST_QWEN_MODEL_DIR is required; no checkpoint skip/fallback");
+        let model_path = Path::new(&model_dir);
+        let config = checkpoint_config(model_path);
+        let artifact =
+            std::env::var("MLXCEL_TEST_QWEN_JSONL").expect("MLXCEL_TEST_QWEN_JSONL is required");
+        let schedule: Schedule =
+            serde_json::from_str(FIXTURE).expect("parse embedded token fixture");
+        assert_eq!(schedule.schema, "qwen3-long-determinism-v1");
+        assert_eq!(
+            schedule.prompt_ids.len(),
+            42,
+            "fixed prompt must not be shortened"
+        );
+        assert_eq!(
+            schedule.decode_ids.len(),
+            DECODE_STEPS,
+            "fixed decode must not be shortened"
+        );
+        assert!(
+            schedule
+                .prompt_ids
+                .iter()
+                .chain(&schedule.decode_ids)
+                .all(|&token| token >= 0 && (token as usize) < VOCAB),
+            "invalid fixture token ID"
+        );
+        let mut writer = BufWriter::new(
+            OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&artifact)
+                .expect("create NEW regression JSONL; existing files are not replaced"),
+        );
+
+        // Same public startup helpers as the CLI, before model/GPU operations.
+        mlxcel_core::ensure_persistent_ptx_cache();
+        mlxcel_core::hardware::apply_metal_ops_per_buffer_default();
+        mlxcel_core::hardware::apply_cuda_graph_cache_default();
+        mlxcel_core::hardware::apply_cuda_sdpa_cache_default();
+        mlxcel_core::hardware::apply_cuda_graph_budget_default(Some(model_path));
+        let applied_tuning = mlxcel_core::autotune::ops::apply_tuned_cuda_kernel_env(
+            mlxcel_core::autotune::ops::cuda_kernel_knobs::TILE_M_CAP_BLACKWELL,
+        );
+        let runtime = mlxcel::initialize_runtime_checked().expect("initialize CUDA runtime");
+        assert!(
+            runtime.invalid_device_override.is_none(),
+            "invalid runtime device override"
+        );
+        assert!(
+            matches!(runtime.device, mlxcel::RuntimeDevice::Gpu)
+                && mlxcel_core::default_device_is_gpu(),
+            "CUDA regression cannot pass on a CPU fallback"
+        );
+        assert_eq!(
+            mlxcel_core::hardware::gpu_backend_kind(),
+            mlxcel_core::hardware::GpuBackendKind::Cuda,
+            "requires the actual NVIDIA CUDA backend, not another GPU backend"
+        );
+        let environment: BTreeMap<_, _> = [
+            "MLXCEL_DEVICE",
+            "MLX_USE_CUDA_GRAPHS",
+            "MLX_CUDA_USE_CUDNN_SDPA",
+            "MLXCEL_FORCE_SYNC",
+            "MLXCEL_FUSED_QK_NORM",
+            "MLXCEL_KV_INPLACE_WRITE",
+            "MLXCEL_AUTOTUNE",
+            "MLX_MAX_OPS_PER_BUFFER",
+            "MLX_MAX_MB_PER_BUFFER",
+        ]
+        .into_iter()
+        .filter_map(|key| std::env::var(key).ok().map(|value| (key, value)))
+        .collect();
+        emit(
+            &mut writer,
+            json!({
+                "event": "metadata", "schema": "qwen3-long-determinism-v1",
+                "model": model_dir, "config": config, "runtime": runtime.device.to_string(),
+                "iterations": ITERATIONS, "decode_steps": DECODE_STEPS, "prompt_tokens": 42,
+                "fixture_sha256": digest(FIXTURE.as_bytes()), "environment": environment,
+                "applied_tuning": applied_tuning, "scope": "eager teacher-forced native logits only"
+            }),
+        );
+        writer.flush().expect("flush metadata");
+
+        let (model, _) = mlxcel::load_model(model_path).expect("load required Qwen3 checkpoint");
+        let stream = mlxcel_core::streams::shared_thread_local_generation_stream();
+        mlxcel_core::streams::install_thread_local_default_stream(stream.as_ref());
+        let mut reference: Vec<Snapshot> = Vec::with_capacity(DECODE_STEPS + 1);
+        let mut first_failure = None;
+        let mut evaluated_rows = 0;
+        for iteration in 0..ITERATIONS {
+            model.reset_runtime_state();
+            let mut caches = model.make_caches();
+            let mut divergent_steps = 0;
+            for step in 0..=DECODE_STEPS {
+                let ids = if step == 0 {
+                    schedule.prompt_ids.as_slice()
+                } else {
+                    &schedule.decode_ids[step - 1..step]
+                };
+                let input = mlxcel_core::from_slice_i32(ids, &[1, ids.len() as i32]);
+                let logits = if step == 0 {
+                    model.forward_last_logits(&input, &mut caches, None, ids.len() - 1)
+                } else {
+                    model.forward(&input, &mut caches, None)
+                };
+                let current = snapshot(&logits, iteration, step);
+                let matches = iteration == 0
+                    || (current.dtype == reference[step].dtype
+                        && current.bytes == reference[step].bytes);
+                if !matches {
+                    divergent_steps += 1;
+                    let first_byte = reference[step]
+                        .bytes
+                        .iter()
+                        .zip(&current.bytes)
+                        .position(|(a, b)| a != b);
+                    first_failure.get_or_insert((iteration, step, 42 + step, first_byte));
+                }
+                emit(
+                    &mut writer,
+                    json!({
+                        "event": "step", "iteration": iteration, "step": step,
+                        "context_tokens": 42 + step, "shape": [1, 1, VOCAB],
+                        "dtype": current.dtype, "native_bytes": current.bytes.len(),
+                        "native_sha256": digest(&current.bytes), "finite": true,
+                        "matches_iteration0": matches
+                    }),
+                );
+                if iteration == 0 {
+                    reference.push(current);
+                }
+                evaluated_rows += 1;
+                if step % 32 == 0 {
+                    writer.flush().expect("flush step evidence");
+                }
+            }
+            mlxcel_core::synchronize_default();
+            emit(
+                &mut writer,
+                json!({"event": "iteration_summary", "iteration": iteration,
+                "evaluated_steps": DECODE_STEPS + 1, "divergent_steps": divergent_steps}),
+            );
+            writer.flush().expect("flush iteration evidence");
+        }
+        assert_eq!(evaluated_rows, ITERATIONS * (DECODE_STEPS + 1));
+        emit(
+            &mut writer,
+            json!({"event": "final_summary", "complete": true,
+            "evaluated_rows": evaluated_rows, "iterations": ITERATIONS,
+            "steps_per_iteration": DECODE_STEPS + 1, "first_failure": first_failure,
+            "pass": first_failure.is_none()}),
+        );
+        writer.flush().expect("flush complete regression result");
+        assert!(
+            first_failure.is_none(),
+            "Qwen3 native logits differ: first (iteration, step, context, byte)={first_failure:?}; artifact={artifact}"
+        );
+    }
+}
