diff --git a/src/lib/mlx-cpp/patches/mlx/backend/cuda/scaled_dot_product_attention.cpp b/src/lib/mlx-cpp/patches/mlx/backend/cuda/scaled_dot_product_attention.cpp
--- a/src/lib/mlx-cpp/patches/mlx/backend/cuda/scaled_dot_product_attention.cpp
+++ b/src/lib/mlx-cpp/patches/mlx/backend/cuda/scaled_dot_product_attention.cpp
@@ -616,6 +616,20 @@
 
   // cuDNN SDPA requires Ampere and later.
   if (cu::device(s.device).compute_capability_major() < 8) {
+    return false;
+  }
+
+  // mlxcel #2128: fixed-input BF16 D_qk=128 single-query SDPA produced
+  // nondeterministic output on GB10 with cuDNN 9.13 and 9.24, including direct
+  // cuDNN execution without MLX or CUDA graphs. Route this shape class through
+  // the existing MLX vector/ops fallback; keep prefill and other types/dims.
+  // This is a mitigation, not a claim about every cuDNN version or GPU.
+  // Opt back into normal cuDNN eligibility only for diagnosis or a separately
+  // verified backend; remove this guard only after relevant regressions pass.
+  static bool enable_bf16_d128_decode =
+      env::get_var("MLXCEL_CUDNN_BF16_D128_DECODE", 0);
+  if (!enable_bf16_d128_decode && q.dtype() == bfloat16 &&
+      q.shape(2) == 1 && q.shape(-1) == 128) {
     return false;
   }
 
